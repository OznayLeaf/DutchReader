import { Theme } from "../theme.slint";
import { SecondaryButton } from "../components/button.slint";

export component PlaceholderScreen inherits Rectangle {
    in property <string> title: "";
    in property <string> body: "";
    in property <string> eyebrow: "COMING SOON";
    in property <length> top-inset: 0px;
    in property <length> bottom-inset: 0px;

    callback back();

    background: Theme.bg;

    VerticalLayout {
        padding-left: Theme.space-lg;
        padding-right: Theme.space-lg;
        padding-top: root.top-inset + Theme.space-md;
        padding-bottom: root.bottom-inset + Theme.space-lg;
        spacing: Theme.space-md;

        HorizontalLayout {
            SecondaryButton {
                text: "← Back";
                width: 96px;
                clicked => { root.back(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle { vertical-stretch: 1; }

        VerticalLayout {
            spacing: Theme.space-sm;
            Text {
                text: root.eyebrow;
                color: Theme.accent;
                font-family: Theme.font-ui;
                font-size: Theme.caption;
                font-weight: 700;
                letter-spacing: 1.4px;
                horizontal-alignment: center;
            }
            Text {
                text: root.title;
                color: Theme.text;
                font-family: Theme.font-serif;
                font-size: 34px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: root.body;
                color: Theme.muted;
                font-family: Theme.font-ui;
                font-size: Theme.body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        Rectangle { vertical-stretch: 2; }
    }
}
